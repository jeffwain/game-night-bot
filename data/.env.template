# ---------------------------------------------------------------------------
# Board Game Night Bot - configuration
#
# Only DISCORD_TOKEN is required. Everything else is either auto-detected at
# startup or configured from inside Discord with /config channels.
# ---------------------------------------------------------------------------

# REQUIRED. Discord Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_TOKEN=your_bot_token_here

# Recommended. Timezone for reminders, DMs, and "today"/"tomorrow" parsing.
# Used as the default until you set one with /config channels timezone:<zone>.
# e.g. America/New_York, Europe/London, Asia/Tokyo
TZ=America/Chicago

# Optional. How often the background scanner runs, in milliseconds.
# Defaults to 3600000 (1 hour). Lower it while testing.
#CHECK_INTERVAL_MS=3600000

# Optional. BoardGameGeek XML API application token. Register an app at
# https://boardgamegeek.com/applications then create a token. Sent as
# Authorization: Bearer. Never commit the real value.
#BGG_APP_TOKEN=your_bgg_app_token_here

# Optional. Password for the BGG account that logs plays after host check-in.
# Username is set on the Settings tab. Keep this out of db.json.
#BGG_PASSWORD=your_bgg_password_here

# Optional. Publish a public, PII-free schedule.json for the web viewer.
# Leave unset to disable the web export entirely.
#WEB_EXPORT_DIR=/app/web

# ---------------------------------------------------------------------------
# No longer required - kept only for backward compatibility.
#
#   DISCORD_CLIENT_ID       read from the logged-in bot application
#   DISCORD_GUILD_ID        discovered from the gateway; commands register in
#                           every server the bot joins, including new ones
#   DISCORD_CHANNEL_ID      set with /config channels announcements:#channel
#   NOTIFICATIONS_CHANNEL_ID  set with /config channels notifications:#channel
# ---------------------------------------------------------------------------

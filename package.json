{
  "name": "game-night-bot",
  "version": "2.4.1",
  "description": "Discord bot that runs a hosting rotation for a recurring board game night, with a LAN web control panel.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "web": "node scripts/web-only.js",
    "test": "node src/testDb.js && node src/testFeatures.js && node src/testRotation.js && node src/testWeb.js && node src/testBgg.js && node src/testSupplement.js && node scripts/testReleaseGuards.js",
    "test:db": "node src/testDb.js",
    "test:features": "node src/testFeatures.js",
    "test:rotation": "node src/testRotation.js",
    "test:web": "node src/testWeb.js",
    "test:bgg": "node src/testBgg.js",
    "test:supplement": "node src/testSupplement.js",
    "test:release": "node scripts/testReleaseGuards.js",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "release:check": "node scripts/release-preflight.js",
    "release:doctor": "node scripts/release-doctor.js",
    "preversion": "node scripts/release-preflight.js && npm run lint && npm test",
    "postversion": "git push --follow-tags && node scripts/release-posted.js"
  },
  "dependencies": {
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffwain/game-night-bot.git"
  },
  "bugs": {
    "url": "https://github.com/jeffwain/game-night-bot/issues"
  },
  "homepage": "https://github.com/jeffwain/game-night-bot#readme",
  "engines": {
    "node": ">=20"
  },
  "private": true
}
